# Copy this file to .env and fill in your real keys. Never commit .env.

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Tavily search API key (free tier: 1,000 searches/month) — https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Which Claude model to use. Use Haiku while developing/testing to keep costs near zero.
# Options: claude-haiku-4-5-20251001, claude-sonnet-5, claude-opus-5
AUTOAGENT_MODEL=claude-haiku-4-5-20251001

# Safety cap: max reasoning/tool-call iterations before the agent is forced to stop.
AUTOAGENT_MAX_STEPS=8
