# Copy this file to .env and fill in your real keys. Never commit .env.

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Tavily search API key (free tier: 1,000 searches/month) — https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Tavily search depth: "basic" (cheaper, faster) or "advanced" (higher quality, more credits)
TAVILY_SEARCH_DEPTH=advanced

# Which Claude model to use. Use Haiku while developing/testing to keep costs near zero.
# Options: claude-haiku-4-5-20251001, claude-sonnet-5, claude-opus-5
STUDYAGENT_MODEL=claude-haiku-4-5-20251001

# Safety cap: max model calls per run, including the final writing step.
STUDYAGENT_MAX_STEPS=8

# Output-token cap per model response (1000-20000). A final document that still
# hits the cap is continued automatically up to two times.
STUDYAGENT_MAX_TOKENS=16000

# Characters of page content kept per search result. Higher = more evidence
# for the agent, more input tokens per step.
STUDYAGENT_SNIPPET_CHARS=1000

# The older AUTOAGENT_MODEL / AUTOAGENT_MAX_STEPS names still work.
